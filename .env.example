# Tesla Developer App
TESLA_CLIENT_ID=your_tesla_client_id
TESLA_CLIENT_SECRET=your_tesla_client_secret
TESLA_REDIRECT_URI=https://your-app.railway.app/auth/callback

# Tesla API Region (na = North America / Asia-Pacific including Japan)
TESLA_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# Google Sheets
GOOGLE_SHEET_ID=your_google_spreadsheet_id
# Path to service account JSON key file (or use GOOGLE_SERVICE_ACCOUNT_JSON for inline JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# App Secret (used for session signing)
APP_SECRET_KEY=change_this_to_a_random_secret_string
